# Copy to .env to override the defaults used by docker-compose.yml (.env is git-ignored)
POSTGRES_DB=todoapp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Host port the app is exposed on
APP_PORT=8081
# SMTP for confirmation/reset emails (e.g. Gmail address + app password). Leave empty to show links on the page instead.
# Optional, default to Gmail; set for another provider (for example Brevo: smtp-relay.brevo.com)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Sender address, must be verified with the provider; defaults to SMTP_USERNAME
SMTP_FROM_ADDRESS=
SMTP_USERNAME=SMTP_USERNAME=bd50fa001@smtp-brevo.com
SMTP_PASSWORD=
# Local use only, without SMTP: shows the email confirmation link on the page. Never set to true on a public site.
ACCOUNT_SHOW_CONFIRMATION_LINK=false
