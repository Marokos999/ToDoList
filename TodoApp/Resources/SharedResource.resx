  <data name="LandingTitle" xml:space="preserve"><value>Svi tvoji zadaci na jednom mestu</value></data>
  <data name="LandingSubtitle" xml:space="preserve"><value>Pravi liste, postavljaj prioritete i rokove, deli ih sa drugima i prati šta je završeno.</value></data>
