@page "/list/{ListId:guid}"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject ITodoService TodoService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IConfiguration Config
@inject DialogService DialogService

<PageTitle>@(list?.Name ?? "Lista")</PageTitle>

<div class="container mt-4">
    <div class="d-flex align-items-center gap-3 mb-4">
        <RadzenButton Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Click="@(() => Nav.NavigateTo("/"))" />
        @if (isRenaming)
        {
            <form class="d-flex align-items-center gap-2 flex-grow-1" @onsubmit="SaveName" @onsubmit:preventDefault>
                <RadzenTextBox @bind-Value="nameDraft" Style="width:100%; max-width:400px" />
                <RadzenButton Text="Sačuvaj" ButtonType="ButtonType.Submit" />
                <RadzenButton Text="Odustani" ButtonStyle="ButtonStyle.Light" Click="@(() => isRenaming = false)" />
                @if (!string.IsNullOrEmpty(nameError))
                {
                    <small class="text-danger">@nameError</small>
                }
            </form>
        }
        else
        {
            <h3 class="mb-0">@(list?.Name ?? "...")</h3>
            @if (list?.OwnerId == userId)
            {
                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Click="StartRename" title="Preimenuj listu" />
                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Click="DeleteList" title="Obriši listu" Style="margin-left:auto" />
            }
        }
    </div>

    @if (items is null)
    {
        <p>Učitavanje...</p>
    }
    else if (list is null)
    {
        <p class="text-muted">Nemaš pristup ovoj listi ili ona ne postoji.</p>
    }
    else
    {
        @* Forma za novi task *@
        <div class="card mb-4 shadow-sm">
            <form class="card-body" @onsubmit="AddItem" @onsubmit:preventDefault>
                <div class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label">Naziv</label>
                        <RadzenTextBox @bind-Value="newTitle" Placeholder="Novi zadatak..." Style="width:100%" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Prioritet</label>
                        <RadzenDropDown @bind-Value="newPriority" Data="@priorityOptions" TextProperty="Text" ValueProperty="Value" Style="width:100%" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Rok</label>
                        <RadzenDatePicker @bind-Value="newDueDate" DateFormat="dd.MM.yyyy" Style="width:100%" />
                    </div>
                    <div class="col-md-1">
                        <RadzenButton Icon="add" ButtonType="ButtonType.Submit" Disabled="@isSaving" Style="width:100%" />
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(titleError))
                {
                    <small class="text-danger d-block mt-1">@titleError</small>
                }
            </form>
        </div>

        @* Lista taskova *@
        @if (!items.Any())
        {
            <p class="text-muted">Nema zadataka. Dodajte prvi!</p>
        }
        else
        {
            <div class="mb-3">
                <RadzenSelectBar @bind-Value="filter" Size="ButtonSize.Small">
                    <Items>
                        <RadzenSelectBarItem Text="Svi" Value="@ItemFilter.All" />
                        <RadzenSelectBarItem Text="Aktivni" Value="@ItemFilter.Active" />
                        <RadzenSelectBarItem Text="Završeni" Value="@ItemFilter.Completed" />
                    </Items>
                </RadzenSelectBar>
            </div>

            @if (!VisibleItems.Any())
            {
                <p class="text-muted">Nema zadataka u ovom prikazu.</p>
            }

            @foreach (var item in VisibleItems)
            {
                <div class="card mb-2 shadow-sm @(item.IsCompleted ? "opacity-50" : "")">
                    <div class="card-body py-2 d-flex align-items-center gap-3">
                        <RadzenCheckBox Value="@item.IsCompleted"
                                        TValue="bool"
                                        Change="@(_ => ToggleItem(item.Id))" />
                        <span class="flex-grow-1 @(item.IsCompleted ? "text-decoration-line-through" : "")"
                              style="cursor:pointer" @onclick="() => ToggleExpand(item)">
                            @item.Title
                            @if (!string.IsNullOrEmpty(item.Description))
                            {
                                <RadzenIcon Icon="notes" Style="font-size:1rem; vertical-align:middle; margin-left:.25rem; opacity:.6" />
                            }
                        </span>
                        <RadzenBadge Text="@GetPriorityName(item.Priority)"
                                     BadgeStyle="@GetBadgeStyle(item.Priority)" />
                        @if (item.DueDate.HasValue)
                        {
                            <small class="@(IsOverdue(item) ? "text-danger fw-semibold" : "text-muted")"
                                   title="@(IsOverdue(item) ? "Rok je prošao" : null)">@item.DueDate.Value.ToString("dd.MM.")</small>
                        }
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger"
                                      Size="ButtonSize.Small"
                                      Click="@(() => DeleteItem(item))" />
                    </div>
                    @if (expandedItemId == item.Id)
                    {
                        <form class="card-body pt-0" @onsubmit="@(() => SaveItem(item.Id))" @onsubmit:preventDefault>
                            <div class="row g-2 mb-2">
                                <div class="col-md-6">
                                    <label class="form-label">Naziv</label>
                                    <RadzenTextBox @bind-Value="titleDraft" Style="width:100%" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Prioritet</label>
                                    <RadzenDropDown @bind-Value="priorityDraft" Data="@priorityOptions" TextProperty="Text" ValueProperty="Value" Style="width:100%" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Rok</label>
                                    <RadzenDatePicker @bind-Value="dueDateDraft" DateFormat="dd.MM.yyyy" AllowClear="true" Style="width:100%" />
                                </div>
                            </div>
                            <label class="form-label">Opis</label>
                            <RadzenTextArea @bind-Value="descriptionDraft" Placeholder="Dodaj opis..." Rows="3" Style="width:100%" />
                            <div class="d-flex justify-content-end align-items-center gap-2 mt-2">
                                @if (!string.IsNullOrEmpty(editError))
                                {
                                    <small class="text-danger me-auto">@editError</small>
                                }
                                <RadzenButton Text="Odustani" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => expandedItemId = null)" />
                                <RadzenButton Text="Sačuvaj" ButtonType="ButtonType.Submit" Size="ButtonSize.Small" />
                            </div>
                        </form>
                    }
                </div>
            }
        }

        @* Deljenje liste *@
        @if (list.OwnerId == userId)
        {
            <div class="mt-4">
                <h6>Deli listu</h6>
                <div class="d-flex gap-2">
                    <RadzenTextBox @bind-Value="shareEmail" Placeholder="Email korisnika..." Style="width:300px" />
                    <RadzenButton Text="Deli" Click="ShareList" />
                </div>
                @if (!string.IsNullOrEmpty(shareMessage))
                {
                    <small class="@(shareSucceeded ? "text-success" : "text-danger") mt-1 d-block">@shareMessage</small>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public Guid ListId { get; set; }

    private TodoList? list;
    private List<TodoItem>? items;
    private string userId = string.Empty;

    private string newTitle = string.Empty;
    private Priority newPriority = Priority.Medium;
    private DateTime? newDueDate;
    private static readonly List<PriorityOption> priorityOptions =
        Enum.GetValues<Priority>().Select(p => new PriorityOption(p, GetPriorityName(p))).ToList();
    private bool isSaving;
    private string titleError = string.Empty;
    private ItemFilter filter = ItemFilter.All;

    private string shareEmail = string.Empty;
    private string shareMessage = string.Empty;
    private bool shareSucceeded;

    private Guid? expandedItemId;
    private string titleDraft = string.Empty;
    private Priority priorityDraft;
    private DateTime? dueDateDraft;
    private string descriptionDraft = string.Empty;
    private string editError = string.Empty;

    private bool isRenaming;
    private string nameDraft = string.Empty;
    private string nameError = string.Empty;

    private HubConnection? hubConnection;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        await LoadData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var hubUrl = Config["TodoHubUrl"] ?? Nav.ToAbsoluteUri("/todohub").ToString();

        hubConnection = new HubConnectionBuilder()
            .WithUrl(hubUrl)
            .Build();

        hubConnection.On("TaskChanged", () => InvokeAsync(async () =>
        {
            await LoadData();
            StateHasChanged();
        }));

        await hubConnection.StartAsync();
        await hubConnection.SendAsync("JoinListAsync", ListId.ToString());
    }

    private async Task LoadData()
    {
        list = await TodoService.GetListAsync(ListId, userId);
        await LoadItems();
    }

    private async Task LoadItems()
    {
        items = await TodoService.GetItemsAsync(ListId, userId);
    }

    private async Task AddItem()
    {
        if (isSaving) return;
        if (string.IsNullOrWhiteSpace(newTitle))
        {
            titleError = "Unesi naziv zadatka.";
            return;
        }

        isSaving = true;
        titleError = string.Empty;
        await TodoService.AddItemAsync(ListId, newTitle.Trim(), newPriority, newDueDate, userId);
        await LoadItems();
        newTitle = string.Empty;
        newDueDate = null;
        isSaving = false;
    }

    private async Task ToggleItem(Guid itemId)
    {
        await TodoService.ToggleCompleteAsync(itemId, userId);
        await LoadItems();
    }

    private async Task DeleteItem(TodoItem item)
    {
        var confirmed = await DialogService.Confirm(
            @<span>Da li sigurno želiš da obrišeš zadatak „@item.Title“?</span>,
            "Brisanje zadatka",
            new ConfirmOptions { OkButtonText = "Obriši", CancelButtonText = "Odustani" });
        if (confirmed != true) return;

        await TodoService.DeleteItemAsync(item.Id, userId);
        await LoadItems();
    }

    private void ToggleExpand(TodoItem item)
    {
        if (expandedItemId == item.Id)
        {
            expandedItemId = null;
            return;
        }

        expandedItemId = item.Id;
        titleDraft = item.Title;
        priorityDraft = item.Priority;
        dueDateDraft = item.DueDate;
        descriptionDraft = item.Description ?? string.Empty;
        editError = string.Empty;
    }

    private async Task SaveItem(Guid itemId)
    {
        if (string.IsNullOrWhiteSpace(titleDraft))
        {
            editError = "Unesi naziv zadatka.";
            return;
        }

        await TodoService.UpdateItemAsync(itemId, titleDraft, priorityDraft, dueDateDraft, descriptionDraft, userId);
        await LoadItems();
        expandedItemId = null;
    }

    private void StartRename()
    {
        nameDraft = list?.Name ?? string.Empty;
        nameError = string.Empty;
        isRenaming = true;
    }

    private async Task SaveName()
    {
        if (string.IsNullOrWhiteSpace(nameDraft))
        {
            nameError = "Unesi naziv liste.";
            return;
        }

        await TodoService.RenameListAsync(ListId, nameDraft, userId);
        await LoadData();
        isRenaming = false;
    }

    private async Task DeleteList()
    {
        var confirmed = await DialogService.Confirm(
            @<span>Da li sigurno želiš da obrišeš listu „@(list?.Name)“?</span>,
            "Brisanje liste",
            new ConfirmOptions { OkButtonText = "Obriši", CancelButtonText = "Odustani" });
        if (confirmed != true) return;

        await TodoService.DeleteListAsync(ListId, userId);
        Nav.NavigateTo("/");
    }

    private async Task ShareList()
    {
        if (string.IsNullOrWhiteSpace(shareEmail))
        {
            shareSucceeded = false;
            shareMessage = "Unesi email korisnika.";
            return;
        }

        var result = await TodoService.ShareListAsync(ListId, userId, shareEmail);
        shareSucceeded = result == ShareResult.Shared;
        shareMessage = result switch
        {
            ShareResult.Shared => "Lista je podeljena!",
            ShareResult.UserNotFound => "Ne postoji korisnik sa tim emailom.",
            ShareResult.AlreadyShared => "Lista je već podeljena sa tim korisnikom.",
            ShareResult.SelfShare => "Ne možeš da podeliš listu sa sobom.",
            _ => "Samo vlasnik može da deli listu."
        };
        if (shareSucceeded) shareEmail = string.Empty;
    }

    private BadgeStyle GetBadgeStyle(Priority p) => p switch
    {
        Priority.High => BadgeStyle.Danger,
        Priority.Medium => BadgeStyle.Warning,
        _ => BadgeStyle.Light
    };

    private static string GetPriorityName(Priority p) => p switch
    {
        Priority.High => "Visok",
        Priority.Medium => "Srednji",
        _ => "Nizak"
    };

    private IEnumerable<TodoItem> VisibleItems => (items ?? [])
        .Where(i => filter switch
        {
            ItemFilter.Active => !i.IsCompleted,
            ItemFilter.Completed => i.IsCompleted,
            _ => true
        })
        .OrderBy(i => i.IsCompleted);

    private static bool IsOverdue(TodoItem item) =>
        !item.IsCompleted && item.DueDate is { } due && due.Date < DateTime.Today;

    private record PriorityOption(Priority Value, string Text);

    private enum ItemFilter { All, Active, Completed }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}