@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ITodoService TodoService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<PageTitle>Moje liste</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Moje To-Do liste</h3>
        <RadzenButton Text="Nova lista" Icon="add" Click="@(() => { nameError = string.Empty; showDialog = true; })" />
    </div>

    @if (lists is null)
    {
        <p>Učitavanje...</p>
    }
    else if (!lists.Any())
    {
        <p class="text-muted">Nemate nijednu listu. Kreirajte prvu!</p>
    }
    else
    {
        <div class="row g-3">
            @foreach (var list in lists)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm" style="cursor:pointer"
                         @onclick="() => GoToList(list.Id)">
                        <div class="card-body">
                            <h5 class="card-title">@list.Name</h5>
                            @if (list.IsShared)
                            {
                                <div class="mb-2">
                                    <RadzenBadge Text="Podeljeno sa tobom" BadgeStyle="BadgeStyle.Info" />
                                </div>
                            }
                            <div class="d-flex justify-content-between">
                                <small class="text-muted">@list.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</small>
                                <small class="text-muted">@(list.TotalItems == 0 ? "Nema zadataka" : $"{list.CompletedItems}/{list.TotalItems} urađeno")</small>
                            </div>
                            @if (list.TotalItems > 0)
                            {
                                <div class="progress mt-2" style="height:4px">
                                    <div class="progress-bar" style="width:@(list.CompletedItems * 100 / list.TotalItems)%"></div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (showDialog)
{
    <div class="modal show d-block" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nova lista</h5>
                    <button class="btn-close" @onclick="() => showDialog = false"></button>
                </div>
                <form @onsubmit="CreateList" @onsubmit:preventDefault>
                    <div class="modal-body">
                        <RadzenTextBox @bind-Value="newListName" Placeholder="Naziv liste..." Style="width:100%" />
                        @if (!string.IsNullOrEmpty(nameError))
                        {
                            <small class="text-danger d-block mt-1">@nameError</small>
                        }
                    </div>
                    <div class="modal-footer">
                        <RadzenButton Text="Odustani" ButtonStyle="ButtonStyle.Light" Click="@(() => showDialog = false)" />
                        <RadzenButton Text="Kreiraj" ButtonType="ButtonType.Submit" Disabled="@isSaving" />
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@code {
    private List<ListSummary>? lists;
    private bool showDialog;
    private string newListName = string.Empty;
    private bool isSaving;
    private string nameError = string.Empty;
    private string userId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        await LoadLists();
    }

    private async Task LoadLists()
    {
        lists = await TodoService.GetListsForUserAsync(userId);
    }

    private async Task CreateList()
    {
        if (isSaving) return;
        if (string.IsNullOrWhiteSpace(newListName))
        {
            nameError = "Unesi naziv liste.";
            return;
        }

        isSaving = true;
        nameError = string.Empty;
        await TodoService.CreateListAsync(newListName.Trim(), userId);
        newListName = string.Empty;
        showDialog = false;
        await LoadLists();
        isSaving = false;
    }

    private void GoToList(Guid id) => Nav.NavigateTo($"/list/{id}");
}