@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@inject ITodoService TodoService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<PageTitle>Moje liste</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Moje To-Do liste</h3>
        <RadzenButton Text="Nova lista" Icon="add" Click="@(() => showDialog = true)" />
    </div>

    @if (lists is null)
    {
        <p>Učitavanje...</p>
    }
    else if (!lists.Any())
    {
        <p class="text-muted">Nemate ni jednu listu. Kreirajte prvu!</p>
    }
    else
    {
        <div class="row g-3">
            @foreach (var list in lists)
            {
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm" style="cursor:pointer"
                         @onclick="() => GoToList(list.Id)">
                        <div class="card-body">
                            <h5 class="card-title">@list.Name</h5>
                            <small class="text-muted">@list.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</small>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (showDialog)
{
    <div class="modal show d-block" style="background:rgba(0,0,0,.4)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Nova lista</h5>
                    <button class="btn-close" @onclick="() => showDialog = false"></button>
                </div>
                <div class="modal-body">
                    <RadzenTextBox @bind-Value="newListName" Placeholder="Naziv liste..." Style="width:100%" />
                </div>
                <div class="modal-footer">
                    <RadzenButton Text="Odustani" ButtonStyle="ButtonStyle.Light" Click="@(() => showDialog = false)" />
                    <RadzenButton Text="Kreiraj" Click="CreateList" />
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<TodoList>? lists;
    private bool showDialog;
    private string newListName = string.Empty;
    private string userId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
        await LoadLists();
    }

    private async Task LoadLists()
    {
        lists = await TodoService.GetListsForUserAsync(userId);
    }

    private async Task CreateList()
    {
        if (string.IsNullOrWhiteSpace(newListName)) return;
        await TodoService.CreateListAsync(newListName, userId);
        newListName = string.Empty;
        showDialog = false;
        await LoadLists();
    }

    private void GoToList(Guid id) => Nav.NavigateTo($"/list/{id}");
}